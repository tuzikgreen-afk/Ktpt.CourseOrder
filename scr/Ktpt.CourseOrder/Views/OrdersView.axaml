<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ktpt.CourseOrder.Views.OrdersView"
             Tag="Список заказов">
	<DockPanel>
		<StackPanel DockPanel.Dock="Top" Spacing="10">
			<TextBlock Classes="heading" Text="Список заказов" />
			<StackPanel Orientation="Horizontal" Spacing="10">
				<!-- Эти три кнопки точно соответствуют методам в твоем .cs файле -->
				<Button Content="Состав заказа" Classes="accent" Click="OpenClick" />
				<Button Content="Новый заказ" Click="NewClick" />
				<Button Content="Обновить" Click="ReloadClick" />
			</StackPanel>
		</StackPanel>

		<!-- Список заказов, каждый элемент будет показан через Order.ToString() -->
		<ListBox x:Name="OrdersList" />
	</DockPanel>
</UserControl>