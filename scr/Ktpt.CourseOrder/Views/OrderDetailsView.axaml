<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ktpt.CourseOrder.Views.OrderDetailsView"
             Tag="Состав заказа">
	<DockPanel>
		<StackPanel DockPanel.Dock="Top" Spacing="10">
			<TextBlock x:Name="HeaderText" Classes="heading" />
			<TextBlock x:Name="ClientText" />
			<TextBlock x:Name="DateText" />
			<TextBlock x:Name="TotalText" FontWeight="Bold" />
			<StackPanel Orientation="Horizontal" Spacing="10">
				<Button Content="Удалить заказ" Click="DeleteOrderClick" />
				<Button Content="Обновить" Click="ReloadClick" />
			</StackPanel>
			<StackPanel x:Name="AdminPanel" Orientation="Horizontal" Spacing="10">
				<CalendarDatePicker x:Name="DateBox" Width="180" />
				<Button Content="Сохранить дату" Click="SaveDateClick" />
			</StackPanel>
			<Border x:Name="ConfirmPanel" IsVisible="False" Padding="10" Background="#FF8080">
				<StackPanel Spacing="6">
					<TextBlock x:Name="ConfirmText" />
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Да, удалить" Click="ConfirmClick" />
						<Button Content="Отмена" Click="CancelClick" />
					</StackPanel>
				</StackPanel>
			</Border>
			<TextBlock Text="Позиции заказа:" />
		</StackPanel>
		<ListBox x:Name="ItemsList" />
	</DockPanel>
</UserControl>